# Copy to deploy/.env and fill in. Nothing else is required to deploy.

# Served at geosamroad.<BASE_DOMAIN_URL> via the host's Traefik.
BASE_DOMAIN_URL=local.kelvinwei.com

# Directory holding <variant>/*.ckpt, e.g. sgcn/, unet/, sam_rgb/, terramind_base/
CHECKPOINTS_PATH=/mnt/hhd/home/Projects/InstaGeo/model_checkpoints/geosamroad

# Earth Engine service-account key (host path; mounted read-only).
GEE_PRIVATE_KEY_FILE=/path/to/gee-key.json
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=

# cu121 for the old NVIDIA GPU, cpu for a machine without one.
TORCH_VARIANT=cu121
